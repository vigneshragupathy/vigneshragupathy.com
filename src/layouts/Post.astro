---
import Base from './Base.astro';
import Comments from '../components/Comments.astro';
import Newsletter from '../components/Newsletter.astro';
import SeriesNav from '../components/SeriesNav.astro';
import { fmtLong, readingTime, type Post } from '../lib/content';
interface Props { post: Post; older?: Post; newer?: Post }
const { post, older, newer } = Astro.props;
const { title, date, tags, description, cover, coverAlt, coverHidden, image, comments, series, part } = post.data;
const ogImage = cover ?? image;
---
<Base title={title} description={description ?? `${title} · ${fmtLong(date)}`} image={ogImage} type="article">
  <article class="post" data-pagefind-body>
    <header class="post-head">
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{fmtLong(date)}</time>
        <span class="sep">·</span>
        <span>{readingTime(post.body)} min read</span>
      </p>
      {cover && !coverHidden && <img class="cover" src={cover} alt={coverAlt ?? title} loading="eager" />}
    </header>
    {series && part && <SeriesNav series={series} part={part} slug={post.id} mode="top" />}
    <div class="prose"><slot /></div>
    {series && part && <SeriesNav series={series} part={part} slug={post.id} mode="bottom" />}
    <footer class="post-foot">
      {tags.length > 0 && (
        <ul class="tag-list" data-pagefind-ignore>
          {tags.map((t) => <li><a class="tag" href={`/tags/${t}/`}>{t}</a></li>)}
        </ul>
      )}
    </footer>
  </article>
  <Newsletter />
  {(newer || older) && (
    <nav class="pager" aria-label="Post navigation">
      {older ? <a class="pager-older" href={`/${older.id}/`}><small>« Older</small><span>{older.data.title}</span></a> : <span />}
      {newer ? <a class="pager-newer" href={`/${newer.id}/`}><small>Newer »</small><span>{newer.data.title}</span></a> : <span />}
    </nav>
  )}
  {comments && <Comments title={title} />}
</Base>
