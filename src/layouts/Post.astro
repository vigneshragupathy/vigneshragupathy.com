---
import Base from './Base.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const { title, date, tags = [], description } = post.data;
---
<Base title={title} description={description}>
  <article>
    <header class="post-head">
      <h1>{title}</h1>
      <p class="meta">
        <time>{date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        {tags.length > 0 && <span class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</span>}
      </p>
    </header>
    <div class="prose"><slot /></div>
  </article>
</Base>
