---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, tagCounts } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return [...tagCounts(posts).keys()].map((tag) => ({ params: { tag }, props: { posts: posts.filter((p) => p.data.tags.includes(tag)) } }));
}
const { tag } = Astro.params;
const { posts } = Astro.props;
---
<Base title={`#${tag}`} description={`Posts tagged ${tag}`}>
  <div class="section-head"><h1>#{tag}</h1><span class="meta">{posts.length} post{posts.length > 1 ? 's' : ''} · <a href="/tags/">all tags</a></span></div>
  <PostList posts={posts} />
</Base>
