---
import type { Book } from '../lib/content';
interface Props { book: Book }
const { book } = Astro.props;
const { title, author, isbn, coverImage } = book.data;
const src = coverImage ?? (isbn ? `https://covers.openlibrary.org/b/isbn/${isbn}-L.jpg?default=false` : undefined);
---
<div class="book-cover">
  <div class="book-cover-fallback"><span class="bc-title">{title}</span><span class="bc-author">{author}</span></div>
  {src && <img class="book-cover-img" src={src} alt={`Cover of ${title}`} loading="lazy" onerror="this.remove()" />}
</div>
