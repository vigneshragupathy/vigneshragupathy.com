---
/** Sequence of a credentialed call: the agent never sees the value. Four lanes, numbered steps, one trust boundary. */
interface Props { label?: string }
const { label = 'How an agent uses a secret without ever reading it' } = Astro.props;
---
<figure class="diagram">
  <svg viewBox="0 0 760 340" role="img" aria-label={label} xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker id="sf-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--muted)" />
      </marker>
    </defs>

    <!-- lanes -->
    <g class="d-box d-accent">
      <rect x="20" y="20" width="150" height="40" rx="6" />
      <text x="95" y="45" class="d-title">Agent</text>
    </g>
    <g class="d-box">
      <rect x="230" y="20" width="150" height="40" rx="6" />
      <text x="305" y="45" class="d-title">recall</text>
    </g>
    <g class="d-box">
      <rect x="440" y="20" width="150" height="40" rx="6" />
      <text x="515" y="45" class="d-title">Child process</text>
    </g>
    <g class="d-box">
      <rect x="610" y="20" width="130" height="40" rx="6" />
      <text x="675" y="45" class="d-title">Service</text>
    </g>
    <g class="d-lane">
      <line x1="95" y1="60" x2="95" y2="320" />
      <line x1="305" y1="60" x2="305" y2="320" />
      <line x1="515" y1="60" x2="515" y2="320" />
      <line x1="675" y1="60" x2="675" y2="320" />
    </g>

    <!-- trust boundary -->
    <rect x="292" y="66" width="456" height="250" rx="8" class="d-boundary" />
    <text x="520" y="308" class="d-boundary-label">the value exists only here</text>

    <!-- steps -->
    <g class="d-arrow" marker-end="url(#sf-arrow)">
      <line x1="95" y1="96" x2="303" y2="96" />
      <line x1="303" y1="126" x2="97" y2="126" />
      <line x1="95" y1="166" x2="303" y2="166" />
      <line x1="305" y1="206" x2="513" y2="206" />
      <line x1="515" y1="236" x2="673" y2="236" />
      <line x1="673" y1="256" x2="517" y2="256" />
      <line x1="513" y1="276" x2="307" y2="276" />
      <line x1="303" y1="296" x2="97" y2="296" />
    </g>
    <g class="d-step">
      <text x="104" y="90" class="d-left">1  find a secret by description</text>
      <text x="104" y="120" class="d-left">2  id, env var name, usage hint</text>
      <text x="104" y="160" class="d-left">3  exec id -- curl … $TOKEN …</text>
      <text x="410" y="200">4  decrypt, inject as env var</text>
      <text x="594" y="230">5  request</text>
      <text x="594" y="250">6  response</text>
      <text x="410" y="270">7  stdout, stderr</text>
      <text x="104" y="290" class="d-left">8  output, value masked</text>
    </g>
  </svg>
  <figcaption>{label}</figcaption>
</figure>
