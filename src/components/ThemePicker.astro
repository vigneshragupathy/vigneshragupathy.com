---
import { THEMES, THEME_IDS } from '../themes';
---
<div class="tp" id="tp">
  <button class="tp-btn" id="tp-btn" aria-label="Appearance" aria-expanded="false" title="Appearance">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" stroke="none"/>
    </svg>
  </button>
  <div class="tp-menu" id="tp-menu" hidden>
    <div class="tp-label">Mode</div>
    <div class="tp-seg" data-key="mode">
      <button data-val="light">Light</button>
      <button data-val="dark">Dark</button>
      <button data-val="auto">Auto</button>
    </div>
    <div class="tp-label">Theme</div>
    <div class="tp-list" data-key="theme">
      {THEME_IDS.map((t) => <button data-val={t}><span class="tp-dot" data-theme-dot={t}></span>{THEMES[t].label}</button>)}
    </div>
  </div>
</div>

<style>
  .tp { position: relative; display: inline-block; }
  .tp-btn { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; padding: 0;
    border: 1px solid var(--border); border-radius: var(--radius); background: var(--card-bg); color: var(--fg); cursor: pointer; }
  .tp-btn:hover { border-color: var(--accent); color: var(--accent); }
  .tp-menu { position: absolute; right: 0; top: 40px; z-index: 50; min-width: 200px; padding: 10px;
    background: var(--card-bg); color: var(--fg); border: 1px solid var(--border); border-radius: var(--radius);
    box-shadow: 0 8px 24px rgba(0,0,0,0.18); font-family: var(--font); font-size: 0.85rem; font-weight: 400; text-transform: none; letter-spacing: 0; }
  .tp-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin: 6px 0 4px; }
  .tp-seg { display: flex; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  .tp-seg button, .tp-list button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; text-align: left; }
  .tp-seg button { flex: 1; padding: 6px 0; text-align: center; border-right: 1px solid var(--border); }
  .tp-seg button:last-child { border-right: 0; }
  .tp-seg button:disabled { cursor: not-allowed; opacity: 0.45; }
  .tp-seg button:disabled[aria-pressed="true"] { opacity: 1; }
  .tp-seg button[aria-pressed="true"], .tp-list button[aria-pressed="true"] { background: var(--accent); color: var(--accent-fg); }
  .tp-list { display: flex; flex-direction: column; gap: 2px; }
  .tp-list button { display: flex; align-items: center; gap: 8px; padding: 6px 8px; border-radius: calc(var(--radius) / 2); }
  .tp-list button:hover { background: var(--code-bg); }
  .tp-list button[aria-pressed="true"]:hover { background: var(--accent); }
  .tp-dot { width: 14px; height: 14px; border-radius: 50%; border: 1px solid rgba(0,0,0,0.2); flex: none; }
  [data-theme-dot="paper"] { background: linear-gradient(135deg, #fff 50%, #6366f1 50%); }
  [data-theme-dot="terminal"] { background: linear-gradient(135deg, #0b0f0c 50%, #3fb950 50%); }
  [data-theme-dot="editorial"] { background: linear-gradient(135deg, #faf6ef 50%, #9a3412 50%); }
  [data-theme-dot="brutal"] { background: linear-gradient(135deg, #ffe600 50%, #000 50%); }
</style>

<script>
  const root = document.documentElement;
  const btn = document.getElementById('tp-btn')!;
  const menu = document.getElementById('tp-menu')!;
  const mq = matchMedia('(prefers-color-scheme: dark)');

  const get = (k: string, d: string) => { try { return localStorage.getItem(k) || d; } catch { return d; } };
  const set = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };

  const DARK_ONLY = new Set(['terminal']);
  const THEME_LIST = [...menu.querySelectorAll<HTMLButtonElement>('.tp-list button')].map((b) => b.dataset.val!);

  function apply() {
    let theme = get('theme', 'brutal');
    if (!THEME_LIST.includes(theme)) theme = 'brutal';
    const mode = get('mode', 'light');
    const locked = DARK_ONLY.has(theme);
    root.dataset.theme = theme;
    root.dataset.mode = locked ? 'dark' : mode === 'auto' ? (mq.matches ? 'dark' : 'light') : mode;
    menu.querySelectorAll<HTMLButtonElement>('[data-key] button').forEach((b) => {
      const key = b.parentElement!.dataset.key;
      if (key === 'mode') {
        b.disabled = locked;
        b.setAttribute('aria-pressed', String(locked ? b.dataset.val === 'dark' : b.dataset.val === mode));
      } else {
        b.setAttribute('aria-pressed', String(b.dataset.val === theme));
      }
    });
    menu.querySelector('.tp-seg')!.setAttribute('title', locked ? 'This theme is dark only' : '');
  }

  btn.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = menu.hidden;
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('click', (e) => {
    if (!menu.hidden && !menu.contains(e.target as Node)) { menu.hidden = true; btn.setAttribute('aria-expanded', 'false'); }
  });
  const close = () => { menu.hidden = true; btn.setAttribute('aria-expanded', 'false'); };
  menu.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-val]');
    if (!b) return;
    const key = b.parentElement!.dataset.key!;
    set(key, b.dataset.val!);
    apply();
    if (key === 'theme') close();
  });
  mq.addEventListener('change', apply);
  apply();
</script>
