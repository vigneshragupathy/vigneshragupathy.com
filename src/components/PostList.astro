---
import { fmtShort, type Post } from '../lib/content';
interface Props { posts: Post[]; showCover?: boolean }
const { posts, showCover = true } = Astro.props;
---
<ul class="posts">
  {posts.map((p) => (
    <li>
      <a class="post-link" href={`/${p.id}/`}>
        {showCover && p.data.cover && <img class="thumb" src={p.data.cover} alt="" loading="lazy" />}
        <span class="post-link-text">
          <span class="post-title">{p.data.title}</span>
          <span class="meta"><time datetime={p.data.date.toISOString()}>{fmtShort(p.data.date)}</time>
            {p.data.tags.map((t) => <span class="tag">{t}</span>)}</span>
        </span>
      </a>
    </li>
  ))}
</ul>
